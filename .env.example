ADMIN_PASSWORD=
APP_ENCRYPTION_KEY=
SESSION_SECRET=
PORT=8080
BIND_ADDRESS=127.0.0.1
COOKIE_SECURE=false
MAX_CONCURRENT_REQUESTS=100
DATABASE_PATH=/data/app.db
WEB_DIR=/app/web/dist


# 额外免费模型 (逗号分隔): 即使上游模型 id 不带 :-free/-free 后缀也强制视为免费。
# 仅首次启动未保存控制台配置时生效；在控制台「额外免费模型」保存后会优先使用控制台列表。
EXTRA_FREE_MODELS=big-pickle
